{
  "name": "tib-aissistant",
  "version": "2.3.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:quiet": "eslint --quiet .",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir public/storybook",
    "typegen-pocketbase": "pocketbase-typegen --out ./src/types/pocketbase-types.ts --db",
    "commit": "cz",
    "prepare": "husky",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.3",
    "@ai-sdk/openai": "^3.0.4",
    "@ai-sdk/react": "^3.0.11",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "@mdxeditor/editor": "^3.39.1",
    "ai": "^6.0.11",
    "csl-json": "^0.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.18.1",
    "js-base64": "^3.7.7",
    "jszip": "^3.10.1",
    "ky": "^1.14.0",
    "lodash": "^4.17.21",
    "next": "16.3.4",
    "next-client-cookies": "^2.1.1",
    "next-runtime-env": "^3.3.0",
    "next-themes": "^0.4.6",
    "node-html-parser": "^7.0.1",
    "pluralize": "^8.0.0",
    "pocketbase": "^0.26.0",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^9.0.3",
    "react-resizable": "^3.0.5",
    "react-simple-code-editor": "^0.14.1",
    "react-slick": "^0.30.3",
    "react-use": "^17.6.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.83.4",
    "slick-carousel": "^1.8.1",
    "swr": "^2.3.6",
    "use-stick-to-bottom": "^1.1.6",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@eslint/eslintrc": "^3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.5",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/nextjs-vite": "10.3.6",
    "@storybook/react": "10.3.6",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20",
    "@types/pluralize": "^0.0.33",
    "@types/prismjs": "^1.26.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/react-resizable": "^3.0.8",
    "@types/react-slick": "^0.23.13",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "10.3.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "pocketbase-typegen": "^1.3.1",
    "postcss": "^8",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "semantic-release": "^24.2.5",
    "storybook": "10.3.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^5",
    "vite": "^8.0.13"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 8.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular",
          "releaseRules": [
            {
              "type": "chore",
              "release": "patch"
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "build",
                "section": "Build System",
                "hidden": false
              },
              {
                "type": "chore",
                "section": "Build System",
                "hidden": false
              },
              {
                "type": "ci",
                "section": "Continuous Integration",
                "hidden": false
              },
              {
                "type": "docs",
                "section": "Documentation",
                "hidden": false
              },
              {
                "type": "feat",
                "section": "Features",
                "hidden": false
              },
              {
                "type": "fix",
                "section": "Bug Fixes",
                "hidden": false
              },
              {
                "type": "perf",
                "section": "Performance Improvements",
                "hidden": false
              },
              {
                "type": "refactor",
                "section": "Code Refactoring",
                "hidden": false
              },
              {
                "type": "style",
                "section": "Styles",
                "hidden": false
              },
              {
                "type": "test",
                "section": "Tests",
                "hidden": false
              }
            ]
          }
        }
      ],
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/gitlab"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
